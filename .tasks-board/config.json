{
  "$schema": "./tasks-board-config.schema.json",
  "dataFile": ".tasks-board/data.json",
  "coldFile": ".tasks-board/data.archived.json",
  "provenanceFile": ".tasks-board/provenance.jsonl",
  "coldProvenanceFile": ".tasks-board/provenance.archived.jsonl",
  "runsRoot": ".tasks-board/runs",
  "worktreesRoot": ".tasks-board/worktrees",
  "locksRoot": ".tasks-board/.locks",
  "references": {
    "open": "⟦",
    "close": "⟧",
    "definitionPrefix": "def ",
    "documents": [
      "*.md",
      "plugins/*/AGENTS.md"
    ],
    "exclude": [
      "archived/**",
      "wiki-repos/**",
      "node_modules/**"
    ]
  },
  "workflow": {
    "holdTags": {
      "needs-evyatar": "Waits for Evyatar: a decision, an install, his own playtest or an upload (hub rule task-readiness-tags)"
    },
    "stages": [
      {
        "id": "backlog",
        "label": "Backlog",
        "semantic": "default",
        "urgency": 10
      },
      {
        "id": "ready",
        "label": "Ready",
        "semantic": "ready",
        "urgency": 40
      },
      {
        "id": "working",
        "label": "Working",
        "semantic": "working",
        "urgency": 50
      },
      {
        "id": "reviewing",
        "label": "Reviewing",
        "semantic": "review",
        "urgency": 70
      },
      {
        "id": "blocked",
        "label": "Blocked",
        "semantic": "blocked",
        "blocked": true,
        "urgency": 100
      },
      {
        "id": "done",
        "label": "Done",
        "semantic": "terminal",
        "terminal": true,
        "urgency": 0
      }
    ],
    "lifecycles": [
      "active",
      "completed",
      "archived"
    ]
  },
  "outputs": {
    "sessionQueuesDir": ".tasks-board/generated/sessions",
    "boardStateJson": ".tasks-board/generated/board-state.json",
    "boardStateJs": ".tasks-board/generated/board-state.js",
    "boardState": ".tasks-board/generated/board-state.json",
    "snapshot": ".tasks-board/generated/snapshot.json",
    "snapshotSchema": ".tasks-board/generated/snapshot.schema.json",
    "recommendationsJson": ".tasks-board/generated/recommendations.json",
    "dependencyGraphJson": ".tasks-board/generated/dependency-graph.json",
    "activity": ".tasks-board/generated/tasks-board-activity.jsonl",
    "activeTasksJson": ".tasks-board/generated/active-tasks.json",
    "summaryProjectionJson": ".tasks-board/generated/summary-projection.json",
    "leanTasksJson": ".tasks-board/generated/lean-tasks.json",
    "viewerHtml": ".tasks-board/generated/overview.html",
    "watcherOwner": ".tasks-board/generated/.lock/watcher.owner",
    "syncLock": ".tasks-board/generated/.lock/sync.lock"
  },
  "recommendations": {
    "topN": 20
  },
  "git": {
    "commitRepository": "main"
  }
}
